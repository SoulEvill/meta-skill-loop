#!/usr/bin/env bash
# msl: the mechanical half of meta-skill-loop.
#
# Skills stay where your agent tools load them, and msl never edits one except to
# apply a change the user approved. For each managed skill, msl keeps a small git
# repo in $MSL_HOME (default ~/.meta-skill-loop) whose working tree IS the live
# skill folder:
#
#   upstream  pristine versions as published (only for skills someone else publishes)
#   mine      what the tools load: upstream + your refinements; every commit is a version (v1, v2, …)
#
# Feedback entries are plain files next to that repo. The agent does the judgment
# (writing feedback, proposing edits, resolving merges); msl does the bookkeeping.
#
# Portable on purpose: bash 3.2 (macOS default), POSIX userland, git. node is used
# only if present, to read the `skills` CLI lock file; npx only by `msl update`.

set -euo pipefail
unset GIT_DIR GIT_WORK_TREE GIT_INDEX_FILE GIT_OBJECT_DIRECTORY GIT_COMMON_DIR 2>/dev/null || true

MSL_VERSION="0.2.0"
MSL_FORMAT=1
MSL_HOME="${MSL_HOME:-$HOME/.meta-skill-loop}"
TAB="$(printf '\t')"
GD=""            # git dir of the skill being worked on (set by use_skill)
PRIMARY=""       # its live folder: the copy that holds the edits
COPY_CONFLICT=""  # set when two installed copies were edited differently
HELD_LOCKS=""    # per-skill locks this process holds, one per line

# ---------------------------------------------------------------- helpers ---

die() { printf 'msl: %s\n' "$*" >&2; exit 1; }
warn() { printf 'msl: %s\n' "$*" >&2; }
now() { date -u +%Y-%m-%dT%H:%MZ; }
today() { date -u +%Y-%m-%d; }

sha256() {
  if command -v sha256sum >/dev/null 2>&1; then sha256sum | cut -d' ' -f1
  else shasum -a 256 | cut -d' ' -f1; fi
}

# Physical absolute path of a directory (resolves symlinks).
abspath() { (cd "$1" 2>/dev/null && pwd -P); }

tilde() {
  case "$1" in
    "$HOME"/*) printf '~%s\n' "${1#"$HOME"}" ;;
    *) printf '%s\n' "$1" ;;
  esac
}

# shellcheck disable=SC2088  # matches a literal "~/" prefix on purpose
untilde() {
  case "$1" in
    '~/'*) printf '%s/%s\n' "$HOME" "${1#'~/'}" ;;
    *) printf '%s\n' "$1" ;;
  esac
}

# Files that make up a skill: everything except dotfiles and dot-directories.
skill_files() { (cd "$1" && find -L . -type f ! -path '*/.*' | LC_ALL=C sort); }

# Content fingerprint of a folder, before it has a version history.
dir_hash() {
  [ -d "$1" ] || { echo "missing"; return 0; }
  skill_files "$1" | while IFS= read -r f; do
    printf '%s\n' "$f"
    cat "$1/$f"
  done | sha256 | cut -c1-12
}

# Make the skill files in $2 match those in $1, in place. Only skill files are
# touched: dotfiles and dot-directories (a local .env, a .git) are left alone,
# since msl doesn't version them. Never onto itself: installers may turn one
# copy into a symlink to another.
copy_tree() {
  local src="$1" dst="$2" f
  [ "$(abspath "$src")" != "$(abspath "$dst")" ] || return 0
  mkdir -p "$dst"
  skill_files "$dst" | while IFS= read -r f; do
    [ -f "$src/$f" ] || rm -f "$dst/$f"
  done
  skill_files "$src" | while IFS= read -r f; do
    mkdir -p "$dst/$(dirname "$f")"
    rm -f "$dst/$f"
    cp "$src/$f" "$dst/$f"
  done
  (cd "$dst" && find . -mindepth 1 -depth -type d -empty ! -path '*/.*' -exec rmdir {} \;) 2>/dev/null || true
}

# Newest existing file among the paths on stdin (one per line).
newest() {
  local best="" f
  while IFS= read -r f; do
    [ -f "$f" ] || continue
    if [ -z "$best" ] || [ "$f" -nt "$best" ]; then best="$f"; fi
  done
  printf '%s' "$best"
}

# Read a key from a SKILL.md frontmatter block.
fm_get() {
  awk -v k="$2" '
    { sub(/\r$/, "") }
    NR == 1 { if ($0 != "---") exit; next }
    $0 == "---" { exit }
    index($0, k ":") == 1 {
      v = substr($0, length(k) + 2)
      sub(/^[ \t]+/, "", v); sub(/[ \t]+$/, "", v)
      gsub(/^["\047]|["\047]$/, "", v)
      print v; exit
    }' "$1"
}

# `key: value` fields in msl's own files (workspace.yaml, skill.yaml, feedback frontmatter).
field() { awk -v k="$2" 'index($0, k ": ") == 1 { print substr($0, length(k) + 3); exit }' "$1"; }

# Set `key: value` in a feedback file's frontmatter (added if absent), or delete it (no value).
set_field() { # file key [value]
  local tmp
  tmp="$(mktemp)"
  awk -v k="$2" -v v="${3:-}" -v del="$([ $# -ge 3 ] || echo 1)" '
    NR == 1 && $0 == "---" { infm = 1; print; next }
    infm && $0 == "---" { if (!done && !del) print k ": " v; infm = 0; print; next }
    infm && index($0, k ": ") == 1 { if (!del) print k ": " v; done = 1; next }
    { print }' "$1" > "$tmp"
  mv "$tmp" "$1"
}

# ---------------------------------------------------------------- workspace ---

ws_id() { field "$MSL_HOME/workspace.yaml" id; }

ensure_ws() { [ -f "$MSL_HOME/workspace.yaml" ] || cmd_init >/dev/null; }

new_ws_id() {
  local id=""
  while [ "${#id}" -lt 6 ]; do
    id="$id$(dd if=/dev/urandom bs=64 count=1 2>/dev/null | LC_ALL=C tr -dc 'a-z0-9')"
  done
  printf '%s\n' "$id" | cut -c1-6
}

# -------------------------------------------------------- skill discovery ---

# Directories agent tools load skills from: user-level, then the current repo.
skill_roots() {
  local d top
  for d in .agents/skills .cursor/skills .claude/skills .codex/skills; do
    printf '%s\n' "$HOME/$d"
  done
  top="$(git rev-parse --show-toplevel 2>/dev/null || true)"
  if [ -n "$top" ] && [ "$top" != "$HOME" ]; then
    for d in .agents/skills .cursor/skills .claude/skills .codex/skills; do
      printf '%s\n' "$top/$d"
    done
  fi
}

# Is this folder installed directly in a user-level skills folder (where the skills CLI puts it)?
in_user_root() {
  local parent d
  parent="$(abspath "$(dirname "$1")")" || return 1
  for d in .agents/skills .cursor/skills .claude/skills .codex/skills; do
    [ "$parent" != "$(abspath "$HOME/$d" || true)" ] || return 0
  done
  return 1
}

# Every installed skill as "name<TAB>physical-dir", in root order, deduplicated.
all_skills() {
  skill_roots | while IFS= read -r root; do
    [ -d "$root" ] || continue
    find -L "$root" -maxdepth 3 -name SKILL.md 2>/dev/null | while IFS= read -r f; do
      case "${f#"$root"/}" in .*|*/.*) continue ;; esac
      d="$(abspath "$(dirname "$f")")" || continue
      n="$(fm_get "$f" name)"
      [ -n "$n" ] || n="$(basename "$d")"
      printf '%s\t%s\n' "$n" "$d"
    done
  done | awk -F '\t' '!seen[$2]++'
}

# Read a skill's entry in the `skills` CLI lock file (~/.agents/.skill-lock.json).
#   lock_info <name> url    -> https://github.com/o/r.git
#   lock_info <name> path   -> skills/<name> (the folder inside that repo)
#   lock_info <name> rev    -> first 12 chars of the upstream folder hash
lock_info() {
  local lock="$HOME/.agents/.skill-lock.json"
  [ -f "$lock" ] || return 0
  command -v node >/dev/null 2>&1 || return 0
  node -e '
    const fs = require("fs");
    const [lock, name, what] = process.argv.slice(1);
    const data = JSON.parse(fs.readFileSync(lock, "utf8"));
    const e = (data.skills && data.skills[name]) || data[name];
    if (!e || typeof e !== "object") process.exit(0);
    let out = "";
    if (what === "rev") out = String(e.skillFolderHash || e.computedHash || "").slice(0, 12);
    else if (what === "path") out = String(e.skillPath || "").replace(/\/?SKILL\.md$/, "");
    else out = e.sourceUrl || e.source || "";
    process.stdout.write(out);
  ' "$lock" "$1" "$2" 2>/dev/null || true
}

# ---------------------------------------------------------- managed state ---

skill_dir() { printf '%s\n' "$MSL_HOME/skills/$1"; }
meta_file() { printf '%s\n' "$MSL_HOME/skills/$1/skill.yaml"; }
is_managed() { [ -f "$(meta_file "$1")" ]; }
require_managed() { is_managed "$1" || die "'$1' is not managed yet; add it with: msl add $1"; }
meta_get() { field "$(meta_file "$1")" "$2"; }

meta_paths() {
  awk '/^paths:/ { p = 1; next } p && /^  - / { print substr($0, 5); next } p { exit }' \
    "$(meta_file "$1")" | while IFS= read -r x; do untilde "$x"; done
}

managed_names() {
  local d
  for d in "$MSL_HOME"/skills/*/; do
    [ -f "$d/skill.yaml" ] && basename "$d"
  done
  return 0
}

write_meta() { # name kind source_url source_path added paths...
  local name="$1" kind="$2" url="$3" spath="$4" added="$5" p
  shift 5
  {
    printf 'name: %s\nkind: %s\n' "$name" "$kind"
    [ -z "$url" ] || printf 'source_url: %s\n' "$url"
    [ -z "$spath" ] || printf 'source_path: %s\n' "$spath"
    printf 'added: %s\npaths:\n' "$added"
    for p in "$@"; do printf '  - %s\n' "$(tilde "$p")"; done
  } > "$(meta_file "$name")"
}

source_of() { # name -> "url (path)" for display
  local url spath
  url="$(meta_get "$1" source_url)"; spath="$(meta_get "$1" source_path)"
  [ -z "$url" ] || printf '%s%s' "$url" "${spath:+ ($spath)}"
}

# ------------------------------------------------------------ per-skill git ---

g() {
  git -c user.name="meta-skill-loop" -c user.email="msl@localhost" \
    -c core.autocrlf=false -c advice.detachedHead=false --git-dir="$GD" "$@"
}

# git in a pending-merge worktree
gw() { local d="$1"; shift; git -C "$d" -c user.name=meta-skill-loop -c user.email=msl@localhost "$@"; }

use_skill() {
  require_managed "$1"
  lock_skill "$1"
  GD="$(skill_dir "$1")/git"
  PRIMARY="$(meta_paths "$1" | sed -n 1p)"
  resolve_copies "$1"
}

# One msl command at a time per skill: a keep and a diff (or two sessions) must not
# interleave between staging and committing. Held until this process exits.
lock_skill() { # name
  local d n=0 pid
  d="$(skill_dir "$1")/lock"
  case "
$HELD_LOCKS" in *"
$d
"*) return 0 ;; esac
  until mkdir "$d" 2>/dev/null; do
    pid="$(cat "$d/pid" 2>/dev/null || true)"
    if [ -n "$pid" ] && ! kill -0 "$pid" 2>/dev/null; then rm -rf "$d"; continue; fi
    n=$((n + 1))
    [ "$n" -lt 300 ] || die "$1 is busy: another msl command is working on it. Try again in a moment."
    sleep 0.1
  done
  echo "$$" > "$d/pid"
  HELD_LOCKS="$HELD_LOCKS$d
"
  trap release_locks EXIT
}

release_locks() {
  local d
  while IFS= read -r d; do [ -z "$d" ] || rm -rf "$d"; done <<EOF
$HELD_LOCKS
EOF
}

has_upstream() { g show-ref -q --verify refs/heads/upstream; }

# Tree id of a folder's content, without touching the real index.
tree_of_dir() {
  local idx="$GD/msl-scratch-index.$$" t
  rm -f "$idx"
  GIT_INDEX_FILE="$idx" g --work-tree="$1" add -A >/dev/null 2>&1
  t="$(GIT_INDEX_FILE="$idx" g --work-tree="$1" write-tree)"
  rm -f "$idx"
  printf '%s\n' "$t"
}

live_tree() { tree_of_dir "$PRIMARY"; }
mine_tree() { g rev-parse 'mine^{tree}'; }
is_dirty() { [ "$(live_tree)" != "$(mine_tree)" ]; }

# Make another installed copy the primary one (the working tree of the skill's repo).
set_primary() { # name path
  local name="$1" p="$2" kind url spath added r rest
  kind="$(meta_get "$name" kind)"; url="$(meta_get "$name" source_url)"
  spath="$(meta_get "$name" source_path)"; added="$(meta_get "$name" added)"
  rest="$(meta_paths "$name" | grep -vxF "$p" || true)"
  set -- "$p"
  while IFS= read -r r; do [ -z "$r" ] || set -- "$@" "$r"; done <<EOF
$rest
EOF
  write_meta "$name" "$kind" "$url" "$spath" "$added" "$@"
  g config core.worktree "$p"
  PRIMARY="$p"
  COPY_CONFLICT=""
}

# A skill can be installed in several tool folders (say ~/.agents/skills and
# ~/.claude/skills); msl keeps them identical. Whichever copy was edited holds the
# live edits: if that's not the primary one, it becomes the primary. If two copies
# were edited differently, that's a conflict the user resolves (msl keep --from).
resolve_copies() { # name
  local mine pt p t edited="" et=""
  COPY_CONFLICT=""
  [ -n "$(meta_paths "$1" | sed -n 2p)" ] || return 0   # only one copy
  mine="$(mine_tree)"
  if [ -d "$PRIMARY" ]; then pt="$(live_tree)"; else pt="missing"; fi
  while IFS= read -r p; do
    if [ -z "$p" ] || [ ! -f "$p/SKILL.md" ]; then continue; fi
    t="$(tree_of_dir "$p")"
    if [ "$t" = "$mine" ] || [ "$t" = "$pt" ]; then continue; fi
    if [ "$pt" != "$mine" ] && [ "$pt" != missing ]; then COPY_CONFLICT=1; return 0; fi
    if [ -z "$edited" ]; then edited="$p"; et="$t"
    elif [ "$t" != "$et" ]; then COPY_CONFLICT=1; return 0; fi
  done <<EOF
$(meta_paths "$1" | sed 1d)
EOF
  if [ -n "$edited" ]; then
    set_primary "$1" "$edited"
  elif [ "$pt" = missing ]; then
    # The primary copy is gone but another one exists: use it.
    while IFS= read -r p; do
      if [ -n "$p" ] && [ -f "$p/SKILL.md" ]; then set_primary "$1" "$p"; break; fi
    done <<EOF
$(meta_paths "$1" | sed 1d)
EOF
  fi
  return 0
}

# Upstream revisions and trees already recorded on the upstream branch.
upstream_revs() { has_upstream || return 0; g log upstream --format=%B | awk '/^Upstream-Rev: /{ print $2 }'; }
upstream_trees() { has_upstream || return 0; g log upstream --format=%T; }
latest_upstream_rev() { upstream_revs | sed -n 1p; }

# The revision the skill's source reports right now (empty if unknown).
current_rev() { # name
  case "$(meta_get "$1" kind)" in
    skills-cli) lock_info "$1" rev ;;
    git) git -C "$PRIMARY" log -1 --format=%h -- . 2>/dev/null || true ;;
    *) ;;
  esac
}

version_at() { g tag --points-at "$1" 2>/dev/null | grep -E '^v[0-9]+$' | sort -t v -k2 -n | tail -n 1 || true; }
current_version() { version_at mine; }
require_version() { g rev-parse -q --verify "refs/tags/$1" >/dev/null || die "no version $1 (msl history $2)"; }

next_version() {
  local n
  n="$(g tag -l 'v*' | sed 's/^v//' | grep -E '^[0-9]+$' | sort -n | tail -n 1 || true)"
  printf 'v%s\n' "$(( ${n:-0} + 1 ))"
}

# State of a managed skill (call use_skill first):
#   clean            live folder = your current version
#   changed          live edits not kept yet (yours, a creator tool's, or a hand edit)
#   upstream-update  an installer or git pull put a NEW upstream version in place
#   upstream-live    a known upstream version was put back; your refinements aren't live
#   copies-differ    two installed copies were edited differently
#   missing          the folder is gone
skill_state() { # name
  local t rev
  [ -d "$PRIMARY" ] || { echo missing; return 0; }
  [ -z "$COPY_CONFLICT" ] || { echo copies-differ; return 0; }
  t="$(live_tree)"
  [ "$t" != "$(mine_tree)" ] || { echo clean; return 0; }
  if has_upstream; then
    if upstream_trees | grep -x "$t" >/dev/null; then echo upstream-live; return 0; fi
    rev="$(current_rev "$1")"
    if [ -n "$rev" ] && ! upstream_revs | grep -x "$rev" >/dev/null; then echo upstream-update; return 0; fi
    # In a git repo the folder keeps what a pull brought until the update is taken.
    if [ "$(meta_get "$1" kind)" = git ] && ! g merge-base --is-ancestor upstream mine; then
      echo upstream-update; return 0
    fi
  fi
  echo changed
}

# Save live edits as a stash entry, so nothing unversioned can be lost.
autosave() {
  local t last s
  t="$(live_tree)"
  last="$(g rev-parse -q --verify 'refs/stash^{tree}' 2>/dev/null || true)"
  [ "$t" != "$last" ] || return 0
  g add -A >/dev/null 2>&1
  s="$(g stash create "msl autosave $(now)" 2>/dev/null || true)"
  [ -z "$s" ] || g stash store -m "msl autosave $(now)" "$s" >/dev/null
  g read-tree mine  # leave the index on the current version; only the folder holds edits
}

save_if_changed() { [ "$(skill_state "$1")" != changed ] || autosave; }

# True when the latest saved edits are gone from the folder (overwritten by an
# update or reinstall) without having been kept as a version or discarded.
lost_edits() {
  local s t
  s="$(g rev-parse -q --verify refs/stash 2>/dev/null)" || return 1
  [ "$s" != "$(cat "$GD/msl-discarded" 2>/dev/null || true)" ] || return 1
  t="$(g rev-parse "$s^{tree}")"
  [ "$t" != "$(live_tree)" ] || return 1
  ! g log mine --format=%T | grep -x "$t" >/dev/null
}

# Does your version differ from the upstream it was last merged with?
has_refinements() {
  local base
  base="$(g merge-base mine upstream)"
  [ "$(mine_tree)" != "$(g rev-parse "$base^{tree}")" ]
}

sync_mirrors() { # name
  local p
  while IFS= read -r p; do
    if [ -n "$p" ] && [ "$p" != "$PRIMARY" ] && [ -d "$p" ]; then copy_tree "$PRIMARY" "$p"; fi
  done <<EOF
$(meta_paths "$1")
EOF
}

# Put `mine` into the live folder (and its copies).
checkout_mine() { # name
  g add -A >/dev/null 2>&1  # track new files too, so the reset removes them
  g read-tree -u --reset mine
  sync_mirrors "$1"
}

# Tag the new tip of mine as the next version and put it live. Prints the version.
# These run inside $(...), where errexit doesn't reliably stop bash 3.2, so every
# step checks its result: a version is never claimed if git didn't record it.
tag_version() { # name v
  g tag "$2" || return 1
  checkout_mine "$1"
  printf '%s\n' "$2"
}

# Commit the live folder as the next version. Prints the version.
commit_version() { # name message
  local v
  v="$(next_version)"
  g add -A >/dev/null 2>&1
  g commit -q --allow-empty -m "$v: $2" || { g read-tree mine; return 1; }
  tag_version "$1" "$v"
}

# Take the recorded upstream as the next version (a merge commit with upstream's tree).
take_upstream() { # name subject
  local v rev c
  v="$(next_version)"
  rev="$(latest_upstream_rev)"
  c="$(g commit-tree 'upstream^{tree}' -p mine -p upstream -m "$v: $2" -m "Upstream-Rev: $rev")" || return 1
  g update-ref refs/heads/mine "$c" || return 1
  tag_version "$1" "$v"
}

version_failed() { die "git could not record the new version of $1 (see the error above); nothing was changed"; }

# Record a folder's content as a new upstream version (no-op if already known).
import_upstream() { # dir rev
  local t c rev="${2:-unknown}"
  t="$(tree_of_dir "$1")"
  if upstream_trees | grep -x "$t" >/dev/null; then return 1; fi
  c="$(g commit-tree "$t" -p upstream -m "upstream: $rev" -m "Upstream-Rev: $rev")"
  g update-ref refs/heads/upstream "$c"
}

# Record the skill's upstream as its source reports it. For a skill in a git repo
# that's the committed content at HEAD, not the folder: the folder also holds the
# user's uncommitted refinements, which must never count as upstream.
record_upstream() { # name
  local rev src
  rev="$(current_rev "$1")"
  if [ "$(meta_get "$1" kind)" = git ]; then
    src="$(committed_dir)" || die "could not read the committed version of $1 from its git repo"
    if import_upstream "$src" "${rev:-unknown}"; then printf 'recorded upstream %s\n' "${rev:-unknown}"; fi
    rm -rf "$src"
  elif import_upstream "$PRIMARY" "${rev:-unknown}"; then
    printf 'recorded upstream %s\n' "${rev:-unknown}"
  fi
  return 0
}

# The skill folder's committed content at HEAD, exported to a new temporary folder.
committed_dir() {
  local top prefix tmp
  top="$(git -C "$PRIMARY" rev-parse --show-toplevel 2>/dev/null)" || return 1
  prefix="$(git -C "$PRIMARY" rev-parse --show-prefix 2>/dev/null)" || return 1
  tmp="$(mktemp -d)"
  git -C "$top" archive --format=tar "HEAD:$prefix" | tar -xf - -C "$tmp" || { rm -rf "$tmp"; return 1; }
  printf '%s\n' "$tmp"
}

merge_dir() { printf '%s\n' "$(skill_dir "$1")/merge"; }

drop_merge() { # name
  local wt
  wt="$(merge_dir "$1")"
  rm -f "$GD/msl-merge-state"
  [ -d "$wt" ] || return 0
  g worktree remove --force "$wt" >/dev/null 2>&1 || rm -rf "$wt"
  g worktree prune
}

# ---------------------------------------------------------------- feedback ---

feedback_file() { # fb-id -> path
  local f
  f="$(find "$MSL_HOME/skills" "$MSL_HOME/archive" -name "$1.md" -path '*/feedback/*' 2>/dev/null | sed -n 1p || true)"
  [ -n "$f" ] || die "no feedback entry '$1'"
  printf '%s\n' "$f"
}

check_ids() { # ids(comma-separated) skill: each must exist and be feedback on that skill
  local id f
  for id in $(printf '%s' "$1" | tr ',' ' '); do
    f="$(feedback_file "$id")" || exit 1
    [ "$(field "$f" skill)" = "$2" ] || die "$id is feedback on $(field "$f" skill), not $2"
  done
}

next_fb_seq() {
  local wid max
  wid="$(ws_id)"
  max="$(find "$MSL_HOME/ids" "$MSL_HOME/skills" "$MSL_HOME/archive" -name "fb-$wid-*" 2>/dev/null \
    | sed "s/.*fb-$wid-0*\([0-9][0-9]*\)\(\.md\)\{0,1\}\$/\1/" | grep -E '^[0-9]+$' | sort -n | tail -n 1 || true)"
  echo $(( ${max:-0} + 1 ))
}

feedback_files() { # name -> the skill's entries
  local f
  for f in "$(skill_dir "$1")"/feedback/fb-*.md; do [ -f "$f" ] && printf '%s\n' "$f"; done
  return 0
}

count_open() { # name
  local f n=0
  while IFS= read -r f; do
    [ -z "$f" ] || [ "$(field "$f" status)" != open ] || n=$((n + 1))
  done <<EOF
$(feedback_files "$1")
EOF
  echo "$n"
}

# Ids of the entries applied in any of the given versions.
fixed_in() { # name versions...
  local name="$1" f v
  shift
  while IFS= read -r f; do
    if [ -z "$f" ] || [ "$(field "$f" status)" != applied ]; then continue; fi
    for v in "$@"; do
      if [ "$(field "$f" fixed_in)" = "$v" ]; then field "$f" id; break; fi
    done
  done <<EOF
$(feedback_files "$name")
EOF
  return 0
}

mark_applied() { # ids(comma-separated) version
  local id f
  for id in $(printf '%s' "$1" | tr ',' ' '); do
    f="$(feedback_file "$id")"
    set_field "$f" status applied
    set_field "$f" fixed_in "$2"
  done
}

reopen() { # ids...
  local id f
  for id in "$@"; do
    f="$(feedback_file "$id")"
    set_field "$f" status open
    set_field "$f" fixed_in
    printf 'reopened %s\n' "$id"
  done
}

# The conversation the feedback came from, only when the tool says which one it is
# (Claude Code does, with CLAUDE_CODE_SESSION_ID). Guessing "the newest file" could
# attach an unrelated conversation; elsewhere pass --session FILE or quote the exchange.
session_file() {
  [ -n "${CLAUDE_CODE_SESSION_ID:-}" ] || return 0
  printf '%s\n' "$HOME"/.claude/projects/*/"$CLAUDE_CODE_SESSION_ID".jsonl | newest
}

# ---------------------------------------------------------------- launcher ---
# ~/.meta-skill-loop/bin/msl is a tiny launcher, not a copy: it runs the msl inside
# the installed meta-skill-loop skill, so updating the skill (npx skills update,
# git pull) updates msl too. Rewritten whenever it's out of date.

launcher_text() { # hub skill folder
  cat <<EOF
#!/bin/sh
# meta-skill-loop launcher: runs msl from the installed meta-skill-loop skill.
for d in "$1" "\$HOME/.agents/skills/meta-skill-loop" "\$HOME/.cursor/skills/meta-skill-loop" \\
         "\$HOME/.claude/skills/meta-skill-loop" "\$HOME/.codex/skills/meta-skill-loop"; do
  if [ -f "\$d/scripts/msl" ]; then exec "\${MSL_BASH:-bash}" "\$d/scripts/msl" "\$@"; fi
done
echo "msl: the meta-skill-loop skill is not installed. Install it: npx skills add SoulEvill/meta-skill-loop" >&2
exit 1
EOF
}

ensure_launcher() {
  local hub want
  hub="$(abspath "$(dirname "$0")/..")" || return 0
  [ -f "$hub/SKILL.md" ] || return 0   # only when running from inside the skill
  want="$(launcher_text "$hub")"
  if [ "$(cat "$MSL_HOME/bin/msl" 2>/dev/null || true)" != "$want" ]; then
    mkdir -p "$MSL_HOME/bin"
    printf '%s\n' "$want" > "$MSL_HOME/bin/msl"
    chmod +x "$MSL_HOME/bin/msl"
  fi
}

# --------------------------------------------------------------- commands ---

cmd_init() {
  mkdir -p "$MSL_HOME/skills" "$MSL_HOME/sessions" "$MSL_HOME/ids" "$MSL_HOME/bin"
  if [ ! -f "$MSL_HOME/workspace.yaml" ]; then
    printf 'format: %s\nid: %s\ncreated: %s\n' "$MSL_FORMAT" "$(new_ws_id)" "$(today)" > "$MSL_HOME/workspace.yaml"
  fi
  if [ ! -f "$MSL_HOME/README.md" ]; then
    cat > "$MSL_HOME/README.md" <<'EOF'
# meta-skill-loop workspace

Your feedback and skill versions. Skills themselves live where your tools load them.
This folder can contain private work (feedback evidence, copies of conversations):
never push it anywhere public.

    workspace.yaml                   format version, and this workspace's id (used in feedback ids)
    skills/<name>/skill.yaml         where the skill lives, what kind of source it has
    skills/<name>/git/               its versions: branch "mine" (what runs), "upstream" (as published)
    skills/<name>/feedback/          one file per feedback entry
    sessions/                        copies of the conversations feedback was logged in
    ids/                             feedback ids handed out (keeps them unique across skills)
EOF
  fi
  ensure_launcher
  printf 'workspace: %s (id %s)\n' "$(tilde "$MSL_HOME")" "$(ws_id)"
}

list_installed() {
  local found=0 new=0 name path mark rows=""
  while IFS="$TAB" read -r name path; do
    [ -n "$name" ] || continue
    found=$((found + 1))
    if is_managed "$name"; then mark="managed"; else mark="new"; new=$((new + 1)); fi
    rows="$rows$(printf '%-8s %-28s %s' "$mark" "$name" "$(tilde "$path")")
"
  done <<EOF
$(all_skills)
EOF
  printf '%s' "$rows" | LC_ALL=C sort -s -k1,1r -k2,2
  printf '\n%s skill folders found, %s not managed yet. Add one: msl add <name>\n' "$found" "$new"
}

cmd_add() {
  local target="" kind="" url="" spath="" rev="" name="" dir="" n p top others src c
  while [ $# -gt 0 ]; do
    case "$1" in
      --kind) kind="${2:?--kind needs a value}"; shift ;;
      -*) die "add: unknown option $1" ;;
      *) target="$1" ;;
    esac
    shift
  done
  [ -n "$target" ] || { list_installed; return 0; }

  if [ -f "$target/SKILL.md" ]; then
    dir="$(abspath "$target")"
    name="$(fm_get "$dir/SKILL.md" name)"
    [ -n "$name" ] || name="$(basename "$dir")"
  else
    name="$target"
  fi
  case "$name" in */*|.*|'') die "invalid skill name '$name'" ;; esac
  is_managed "$name" && die "'$name' is already managed (msl status $name)"

  # Every installed copy of this skill; an explicit path goes first. Only identical
  # copies are grouped: a different skill that happens to share the name (say, a
  # project's own pr-review next to your personal one) must never be overwritten.
  set --
  [ -n "$dir" ] && set -- "$dir"
  others=""
  while IFS="$TAB" read -r n p; do
    [ "$n" = "$name" ] || continue
    [ "$p" = "$dir" ] && continue
    if [ $# -gt 0 ] && [ "$(dir_hash "$p")" != "$(dir_hash "$1")" ]; then
      others="$others$p
"
      continue
    fi
    set -- "$@" "$p"
  done <<EOF
$(all_skills)
EOF
  [ $# -gt 0 ] || die "no skill named '$name' found in: $(skill_roots | tr '\n' ' ')"

  # Who else writes this folder decides how upstream updates are detected.
  top="$(git -C "$1" rev-parse --show-toplevel 2>/dev/null || true)"
  if [ -z "$kind" ]; then
    # The skills CLI lock is global and keyed by name: it only speaks for a folder the
    # CLI installed (directly in a user-level skills folder), not a same-named team skill.
    if [ -n "$(lock_info "$name" url)" ] && in_user_root "$1"; then
      kind="skills-cli"
    elif [ -n "$top" ] && [ "$top" != "$HOME" ] && [ -n "$(git -C "$1" log -1 --format=%h -- . 2>/dev/null || true)" ]; then
      kind="git"
    else
      kind="local"
    fi
  fi
  case "$kind" in
    local) ;;
    skills-cli) url="$(lock_info "$name" url)"; spath="$(lock_info "$name" path)" ;;
    git) url="$(git -C "$1" config --get remote.origin.url 2>/dev/null || echo "$top")"
         spath="$(git -C "$1" rev-parse --show-prefix 2>/dev/null | sed 's#/$##')" ;;
    *) die "kind must be local, skills-cli, or git" ;;
  esac

  mkdir -p "$(skill_dir "$name")/feedback"
  write_meta "$name" "$kind" "$url" "$spath" "$(today)" "$@"
  GD="$(skill_dir "$name")/git"
  PRIMARY="$1"
  git init -q --bare "$GD"
  g config core.bare false
  g config core.worktree "$PRIMARY"
  g symbolic-ref HEAD refs/heads/mine
  mkdir -p "$GD/info"
  printf '.*\n' >> "$GD/info/exclude"
  case "$kind" in
    local)
      g add -A >/dev/null 2>&1
      g commit -q --allow-empty -m "v1: added to meta-skill-loop" ;;
    skills-cli)
      g add -A >/dev/null 2>&1
      rev="$(current_rev "$name")"
      g commit -q --allow-empty -m "v1: added to meta-skill-loop" -m "Upstream-Rev: ${rev:-unknown}"
      g branch upstream ;;
    git)
      # upstream starts at the committed content; uncommitted changes already in the
      # folder are the user's refinements, so v1 builds on top of it.
      rev="$(current_rev "$name")"
      src="$(committed_dir)" || die "could not read the committed version of $name from its git repo"
      c="$(g commit-tree "$(tree_of_dir "$src")" -m "upstream: ${rev:-unknown}" -m "Upstream-Rev: ${rev:-unknown}")"
      rm -rf "$src"
      g update-ref refs/heads/upstream "$c"
      g update-ref refs/heads/mine "$c"
      g read-tree mine
      g add -A >/dev/null 2>&1
      g commit -q --allow-empty -m "v1: added to meta-skill-loop" ;;
  esac
  g tag v1

  printf 'added %s (%s%s) as v1\n' "$name" "$kind" "${url:+, from $(source_of "$name")}"
  for p in "$@"; do printf '  %s\n' "$(tilde "$p")"; done
  while IFS= read -r p; do
    [ -n "$p" ] || continue
    printf 'note: %s is a different skill with the same name; it was not added and will not be touched.\n' "$(tilde "$p")"
    printf '      To manage that one instead: msl remove %s, then msl add %s\n' "$name" "$(tilde "$p")"
  done <<EOF
$others
EOF
  return 0
}

cmd_remove() {
  local name="${1:-}" dest
  [ -n "$name" ] || die "usage: msl remove <name>"
  require_managed "$name"
  mkdir -p "$MSL_HOME/archive"
  dest="$MSL_HOME/archive/$name-$(date -u +%Y%m%d%H%M%S)"
  mv "$(skill_dir "$name")" "$dest"
  printf 'stopped managing %s; its versions and feedback are archived in %s. The skill itself was not touched.\n' "$name" "$(tilde "$dest")"
}

status_notes() { # name state -> extra lines
  local name="$1" state="$2" p
  case "$state" in
    changed) printf '  %s: live edits, not a version yet (saved). Show: msl diff %s. Then msl keep %s -m "<what changed>" or msl discard %s.\n' "$name" "$name" "$name" "$name" ;;
    upstream-update) printf '  %s: a new upstream version replaced your version in the folder. Review it: msl update %s\n' "$name" "$name" ;;
    upstream-live) printf '  %s: the folder holds a plain upstream version; your refinements are not live. Restore them: msl update %s\n' "$name" "$name" ;;
    copies-differ)
      printf '  %s: installed copies were edited differently:\n' "$name"
      while IFS= read -r p; do [ -z "$p" ] || printf '      %s\n' "$(tilde "$p")"; done <<EOF
$(meta_paths "$name")
EOF
      printf '    Compare them, then keep one: msl keep %s --from <path> -m "<what changed>" (the other copies get its content).\n' "$name" ;;
    missing) printf '  %s: folder is gone. Stop managing it: msl remove %s\n' "$name" "$name" ;;
  esac
  if [ "$state" != missing ] && [ "$state" != changed ] && lost_edits; then
    printf '  %s: your last live edits (saved %s) are no longer in the folder, probably overwritten by an update or reinstall. Preview: msl diff %s --saved. Bring back: msl restore %s\n' \
      "$name" "$(g log -1 --format=%cd --date=format:'%Y-%m-%d %H:%M' refs/stash)" "$name" "$name"
  fi
  if [ -d "$(merge_dir "$name")" ]; then
    printf '  %s: an upstream merge is waiting for review: msl diff %s --merge, then msl update %s --apply or --abort\n' "$name" "$name" "$name"
  elif [ "$state" != missing ] && has_upstream && ! g merge-base --is-ancestor upstream mine 2>/dev/null; then
    printf '  %s: upstream %s is recorded but not merged into your version yet. See it: msl update %s --check\n' "$name" "$(latest_upstream_rev)" "$name"
  fi
}

cmd_status() {
  local name state ver lives copies unmanaged=0 rows=0 notes=""
  ensure_ws
  if [ $# -gt 0 ]; then
    is_managed "$1" || { printf "'%s' is not managed; add it with: msl add %s\n" "$1" "$1"; return 1; }
  fi
  printf '%-24s %-10s %-8s %-5s %-15s %s\n' SKILL KIND VERSION OPEN STATE "LIVES IN"
  for name in $(managed_names | tr '\n' ' '); do
    [ $# -eq 0 ] || [ "$1" = "$name" ] || continue
    rows=$((rows + 1))
    use_skill "$name"
    state="$(skill_state "$name")"
    [ "$state" != changed ] || autosave
    ver="$(current_version)"
    [ "$state" != changed ] || ver="$ver*"
    lives="$(tilde "$PRIMARY")"
    copies="$(meta_paths "$name" | sed 1d | wc -l | tr -d ' ')"
    [ "$copies" = 0 ] || lives="$lives (+$copies)"
    printf '%-24s %-10s %-8s %-5s %-15s %s\n' "$name" "$(meta_get "$name" kind)" "$ver" \
      "$(count_open "$name")" "$state" "$lives"
    notes="$notes$(status_notes "$name" "$state")
"
  done
  [ "$rows" -gt 0 ] || printf '(no managed skills yet: "msl add" lists the installed ones)\n'
  notes="$(printf '%s' "$notes" | grep -v '^$' || true)"
  [ -z "$notes" ] || printf '\n%s\n' "$notes"
  if [ $# -eq 0 ]; then
    while IFS="$TAB" read -r name _; do
      case "$name" in ''|meta-skill-loop|meta-skill-feedback|meta-skill-refine) continue ;; esac
      is_managed "$name" || unmanaged=$((unmanaged + 1))
    done <<EOF
$(all_skills)
EOF
    [ "$unmanaged" = 0 ] || printf '\n%s installed skill folder(s) not managed yet: msl add\n' "$unmanaged"
  fi
  return 0
}

cmd_path() { use_skill "${1:?usage: msl path <name>}"; printf '%s\n' "$PRIMARY"; }

cmd_feedback() {
  local sub="${1:-}"
  [ $# -eq 0 ] || shift
  case "$sub" in
    add) feedback_add "$@" ;;
    list) feedback_list "$@" ;;
    mark) feedback_mark "$@" ;;
    *) die "usage: msl feedback add <name> -t <title> [options] < body | list <name> [--all] | mark <fb-id> open|applied|declined [--fixed-in vN]" ;;
  esac
}

feedback_add() {
  local name="${1:-}" title="" severity="P2" tool="" about="" session="" ver seq id file body src
  [ -n "$name" ] || die "usage: msl feedback add <name> -t <title> [--severity P0|P1|P2|P3|nit] [--tool T] [--version vN] [--session FILE|none] < body"
  shift
  while [ $# -gt 0 ]; do
    case "$1" in
      -t|--title) title="${2:?}"; shift ;;
      --severity) severity="${2:?}"; shift ;;
      --tool) tool="${2:?}"; shift ;;
      --version) about="${2:?}"; shift ;;
      --session) session="${2:?}"; shift ;;
      *) die "feedback add: unknown option $1" ;;
    esac
    shift
  done
  use_skill "$name"
  title="$(printf '%s' "$title" | tr '\n' ' ' | sed 's/^ *//; s/ *$//')"
  [ -n "$title" ] || die "feedback add needs a one-line title: -t \"<what went wrong>\""
  case "$severity" in P0|P1|P2|P3|nit) ;; *) die "severity must be P0, P1, P2, P3, or nit" ;; esac
  if [ -z "$tool" ]; then
    if [ -n "${CLAUDECODE:-}${CLAUDE_CODE_SESSION_ID:-}" ]; then tool="claude-code"; else tool="unknown"; fi
  fi
  body="$(cat)"
  [ -n "$(printf '%s' "$body" | tr -d '[:space:]')" ] || die "feedback body is empty (pass it on stdin)"

  if [ -n "$about" ]; then
    require_version "$about" "$name"
    ver="$about"
  else
    ver="$(current_version)"
    [ ! -d "$PRIMARY" ] || ! is_dirty || { ver="$ver+edits"; save_if_changed "$name"; }
  fi

  # Keep a copy of the conversation next to the feedback (tools delete old ones).
  case "$session" in
    none) session="" ;;
    '') src="$(session_file)" ;;
    *) [ -f "$session" ] || die "no such session file: $session"; src="$session" ;;
  esac
  session=""
  if [ -n "${src:-}" ]; then
    mkdir -p "$MSL_HOME/sessions"
    if cp "$src" "$MSL_HOME/sessions/$(basename "$src")" 2>/dev/null; then
      session="$(tilde "$MSL_HOME/sessions/$(basename "$src")")"
    else
      warn "could not copy the session file $src"
    fi
  fi

  # Ids are unique across the whole workspace: reserve one atomically in ids/.
  mkdir -p "$MSL_HOME/ids" "$(skill_dir "$name")/feedback"
  seq="$(next_fb_seq)"
  while :; do
    id="$(printf 'fb-%s-%03d' "$(ws_id)" "$seq")"
    if (set -C; : > "$MSL_HOME/ids/$id") 2>/dev/null; then break; fi
    seq=$((seq + 1))
  done
  file="$(skill_dir "$name")/feedback/$id.md"
  {
    printf -- '---\n'
    printf 'id: %s\nskill: %s\ntitle: %s\nversion: %s\nat: %s\ntool: %s\n' "$id" "$name" "$title" "$ver" "$(now)" "$tool"
    [ -z "$session" ] || printf 'session: %s\n' "$session"
    printf 'severity: %s\nstatus: open\n' "$severity"
    printf -- '---\n%s\n' "$body"
  } > "$file"
  printf '%s logged for %s (%s)\n' "$id" "$name" "$ver"
  if [ -n "$session" ]; then
    printf 'conversation saved: %s\n' "$session"
  else
    printf 'no conversation copied (only one msl can identify: Claude Code, or --session FILE); the entry text is the record\n'
  fi
}

feedback_list() {
  local name="${1:-}" all=0 f shown=0
  [ -n "$name" ] || die "usage: msl feedback list <name> [--all]"
  [ "${2:-}" != "--all" ] || all=1
  require_managed "$name"
  while IFS= read -r f; do
    [ -n "$f" ] || continue
    [ "$all" = 1 ] || [ "$(field "$f" status)" = open ] || continue
    [ "$shown" = 0 ] || printf '\n'
    cat "$f"
    shown=$((shown + 1))
  done <<EOF
$(feedback_files "$name")
EOF
  [ "$shown" -gt 0 ] || printf '(no %sfeedback for %s)\n' "$([ "$all" = 1 ] || echo 'open ')" "$name"
}

feedback_mark() {
  local id="${1:-}" status="${2:-}" v="" file
  if [ -z "$id" ] || [ -z "$status" ]; then
    die "usage: msl feedback mark <fb-id> open|applied|declined [--fixed-in vN]"
  fi
  shift 2
  while [ $# -gt 0 ]; do
    case "$1" in --fixed-in) v="${2:?}"; shift ;; *) die "mark: unknown option $1" ;; esac
    shift
  done
  case "$status" in open|applied|declined) ;; *) die "status must be open, applied, or declined" ;; esac
  file="$(feedback_file "$id")"
  if [ -n "$v" ]; then
    [ "$status" = applied ] || die "--fixed-in only goes with applied"
    use_skill "$(field "$file" skill)"
    require_version "$v" "$(field "$file" skill)"
  fi
  set_field "$file" status "$status"
  if [ -n "$v" ]; then set_field "$file" fixed_in "$v"
  elif [ "$status" != applied ]; then set_field "$file" fixed_in; fi
  printf '%s -> %s%s\n' "$id" "$status" "${v:+ (fixed in $v)}"
}

# msl diff <name>                 your current version -> live edits
# msl diff <name> vA [vB]         between versions (vB defaults to live)
# msl diff <name> --upstream      latest upstream -> your version (your refinements)
# msl diff <name> --merge         your version -> the pending upstream merge
# msl diff <name> --saved         your version -> the last saved live edits (what restore brings back)
cmd_diff() {
  local name="${1:-}" a b wt
  [ -n "$name" ] || die "usage: msl diff <name> [vA [vB] | --upstream | --merge | --saved]"
  use_skill "$name"
  shift
  case "${1:-}" in
    --upstream)
      has_upstream || die "$name has no upstream"
      printf '# upstream %s -> your version %s\n' "$(latest_upstream_rev)" "$(current_version)"
      g diff upstream mine ;;
    --saved)
      g rev-parse -q --verify refs/stash >/dev/null || die "no saved edits for $name"
      printf '# your version %s -> the last saved live edits (what msl restore brings back)\n' "$(current_version)"
      g diff mine refs/stash ;;
    --merge)
      wt="$(merge_dir "$name")"
      [ -d "$wt" ] || die "no upstream merge in progress for $name"
      printf '# your version %s -> pending merge (live folder unchanged)\n' "$(current_version)"
      git -C "$wt" add -A >/dev/null 2>&1
      git -C "$wt" diff --cached mine ;;
    v[0-9]*)
      a="$1"; b="${2:-}"
      require_version "$a" "$name"
      if [ -n "$b" ]; then
        require_version "$b" "$name"
        printf '# %s -> %s\n' "$a" "$b"
        g diff "$a" "$b"
      else
        printf '# %s -> live\n' "$a"
        g diff "$a" "$(live_tree)"
      fi ;;
    "")
      save_if_changed "$name"
      printf '# %s -> live (%s)\n' "$(current_version)" "$(tilde "$PRIMARY")"
      if is_dirty; then
        g diff mine "$(live_tree)"
      else
        printf '(no live edits)\n'
      fi ;;
    *) die "unknown diff option $1" ;;
  esac
}

# Keep the live edits as the next version.
cmd_keep() { # name -m summary [--fixes ids] [--from path]
  local name="${1:-}" msg="" fixes="" from="" state v
  [ -n "$name" ] || die "usage: msl keep <name> -m <summary> [--fixes fb-…,fb-…] [--from <path>]"
  shift
  while [ $# -gt 0 ]; do
    case "$1" in
      -m) msg="${2:?}"; shift ;;
      --fixes) fixes="${2:?}"; shift ;;
      --from) from="${2:?}"; shift ;;
      *) die "keep: unknown option $1" ;;
    esac
    shift
  done
  [ -n "$msg" ] || die "keep needs -m <summary>"
  use_skill "$name"
  if [ -n "$from" ]; then
    from="$(abspath "$from")" || die "no such folder: $from"
    meta_paths "$name" | grep -xF "$from" >/dev/null || die "$from is not an installed copy of $name (msl status $name)"
    set_primary "$name" "$from"
  fi
  state="$(skill_state "$name")"
  case "$state" in
    changed) ;;
    clean) die "nothing to keep: $name has no live edits" ;;
    copies-differ) die "installed copies of $name were edited differently; choose one: msl keep $name --from <path> -m \"$msg\"" ;;
    upstream-update|upstream-live) die "the folder holds an upstream version, not your edits; run: msl update $name" ;;
    missing) die "skill folder missing: $PRIMARY" ;;
  esac
  check_ids "$fixes" "$name"
  autosave
  v="$(commit_version "$name" "$msg")" || version_failed "$name"
  [ -z "$fixes" ] || mark_applied "$fixes" "$v"
  printf '%s kept for %s%s\n' "$v" "$name" "${fixes:+ (applied $fixes)}"
}

cmd_discard() {
  local name="${1:-}"
  [ -n "$name" ] || die "usage: msl discard <name>"
  use_skill "$name"
  [ -z "$COPY_CONFLICT" ] || die "installed copies of $name were edited differently, and discard could only save one of them. Choose one first: msl keep $name --from <path> -m \"<what changed>\" (msl revert undoes it later if you don't want it)"
  is_dirty || { printf '%s has no live edits\n' "$name"; return 0; }
  autosave
  g rev-parse -q --verify refs/stash > "$GD/msl-discarded" || true
  checkout_mine "$name"
  printf 'discarded the live edits to %s; back to %s. They are saved: msl restore %s brings them back.\n' "$name" "$(current_version)" "$name"
}

cmd_restore() {
  local name="${1:-}"
  [ -n "$name" ] || die "usage: msl restore <name>"
  use_skill "$name"
  g rev-parse -q --verify refs/stash >/dev/null || die "nothing saved to restore for $name"
  is_dirty && die "$name has live edits; keep or discard them first"
  g read-tree mine
  if g stash apply -q >/dev/null 2>&1; then
    g read-tree mine
    sync_mirrors "$name"
    printf 'restored the last saved edits to %s (live edits: keep or discard)\n' "$name"
  else
    checkout_mine "$name"
    die "the saved edits no longer apply cleanly to $(current_version); nothing was changed"
  fi
}

cmd_history() {
  local name="${1:-}" dirty="" logs
  [ -n "$name" ] || die "usage: msl history <name>"
  use_skill "$name"
  [ ! -d "$PRIMARY" ] || ! is_dirty || dirty=" (+ live edits)"
  printf '%s  (%s%s)\n\n' "$name" "$(meta_get "$name" kind)" "$(s="$(source_of "$name")"; [ -z "$s" ] || printf ', %s' "$s")"
  printf '  %-6s %-10s %-4s %s\n' VER DATE FB CHANGE
  # One pass over git and one over the feedback, whatever the number of versions.
  # Each log record: "<commit> TAB <date> TAB <subject> TAB <upstream rev>".
  logs="$(g log mine --first-parent --format='%x1e%H%x09%cs%x09%s%n%b' | awk '
    BEGIN { RS = "\036" }
    NF {
      n = split($0, l, "\n"); rev = ""
      for (i = 2; i <= n; i++) if (l[i] ~ /^Upstream-Rev: /) { rev = substr(l[i], 15); break }
      print l[1] "\t" rev
    }')"
  {
    echo "=tags"; g show-ref --tags 2>/dev/null || true
    echo "=feedback"; feedback_summary "$name"
    echo "=log"; printf '%s\n' "$logs"
    echo "=mine $(g rev-parse mine)"
  } | awk -F '\t' '
    /^=tags$/ { part = "t"; next }
    /^=feedback$/ { part = "f"; next }
    /^=log$/ { part = "l"; next }
    /^=mine / { mine = substr($0, 7); next }
    part == "t" {
      split($0, a, " "); t = a[2]; sub(/^refs\/tags\//, "", t)
      if (t ~ /^v[0-9]+$/ && (!(a[1] in ver) || substr(t, 2) + 0 > substr(ver[a[1]], 2) + 0)) ver[a[1]] = t
      next
    }
    part == "f" { if ($1 == "count") count[$2]++; else fixes[$2] = (fixes[$2] == "" ? "" : fixes[$2] " ") $3; next }
    part == "l" && $1 != "" { rec[++n] = $0 }
    END {
      for (i = 1; i <= n; i++) {
        split(rec[i], f, "\t"); v = ver[f[1]]
        if (v == "") continue
        subject = f[3]; if (index(subject, v ": ") == 1) subject = substr(subject, length(v) + 3)
        printf "%s %-6s %-10s %-4s %s%s%s\n", (f[1] == mine ? "*" : " "), v, f[2], count[v] + 0, subject,
          (fixes[v] == "" ? "" : " [fixes " fixes[v] "]"), (f[4] == "" ? "" : " [upstream " f[4] "]")
      }
    }'
  printf '\n* = live%s. FB = feedback logged against that version.\n' "$dirty"
}

# Per feedback entry: "count TAB <version it was about>", plus "fix TAB <version> TAB <id>"
# for applied ones. One awk over all entries.
feedback_summary() { # name
  set -- "$(skill_dir "$1")"/feedback/fb-*.md
  [ -f "$1" ] || return 0
  awk '
    function flush() { if (seen) { print "count\t" ver; if (st == "applied" && fx != "") print "fix\t" fx "\t" id } }
    FNR == 1 { flush(); seen = 1; fm = ($0 == "---"); ver = st = fx = id = ""; next }
    fm && $0 == "---" { fm = 0; next }
    fm && /^version: / { ver = substr($0, 10); sub(/\+edits$/, "", ver) }
    fm && /^status: / { st = substr($0, 9) }
    fm && /^fixed_in: / { fx = substr($0, 11) }
    fm && /^id: / { id = substr($0, 5) }
    END { flush() }' "$@"
}

require_clean_for() { # name
  local state
  state="$(skill_state "$1")"
  case "$state" in
    clean) ;;
    *) die "$1 is '$state'; keep, discard, or update first (msl status $1)" ;;
  esac
}

# Undo one version, keeping everything after it.
cmd_revert() { # name vN
  local name="${1:-}" target="${2:-}" v ids
  if [ -z "$name" ] || [ -z "$target" ]; then die "usage: msl revert <name> <vN>"; fi
  use_skill "$name"
  require_version "$target" "$name"
  g merge-base --is-ancestor "$target" mine || die "$target is not in the history of the current version"
  require_clean_for "$name"
  [ "$(g rev-list --parents -n 1 "$target" | wc -w | tr -d ' ')" -le 2 ] \
    || die "$target took an upstream version; roll back to the version before it instead (msl rollback)"
  [ "$target" != v1 ] || die "v1 is where the history starts; nothing to revert"
  if ! g revert --no-commit "$target" >/dev/null 2>&1; then
    g revert --abort >/dev/null 2>&1 || g read-tree -u --reset mine
    die "undoing only $target conflicts with later versions; roll back to a version instead (msl rollback), or refine"
  fi
  ids="$(fixed_in "$name" "$target" | tr '\n' ' ')"
  v="$(commit_version "$name" "reverted $target")" || { checkout_mine "$name"; version_failed "$name"; }
  # shellcheck disable=SC2086
  reopen $ids
  printf '%s: %s undone for %s\n' "$v" "$target" "$name"
}

# Go back to a version: its content becomes the next version.
cmd_rollback() { # name vN [--yes]
  local name="${1:-}" target="${2:-}" yes=0 v merges ids
  if [ -z "$name" ] || [ -z "$target" ]; then die "usage: msl rollback <name> <vN> [--yes]"; fi
  shift 2
  while [ $# -gt 0 ]; do
    case "$1" in --yes) yes=1 ;; *) die "rollback: unknown option $1" ;; esac
    shift
  done
  use_skill "$name"
  require_version "$target" "$name"
  g merge-base --is-ancestor "$target" mine || die "$target is not in the history of the current version"
  require_clean_for "$name"
  merges="$(g rev-list --merges "$target..mine" | wc -l | tr -d ' ')"
  if [ "$merges" != 0 ] && [ "$yes" = 0 ]; then
    printf 'Going back to %s also brings back an older upstream text: %s upstream update(s) were taken after it.\n' "$target" "$merges"
    printf 'To undo just one of your changes instead: msl revert %s <vN>. To go ahead: add --yes.\n' "$name"
    return 2
  fi
  # shellcheck disable=SC2046
  ids="$(fixed_in "$name" $(g log --first-parent --format=%H "$target..mine" | while IFS= read -r c; do version_at "$c"; done) | tr '\n' ' ')"
  g read-tree -u --reset "$target"
  v="$(commit_version "$name" "rolled back to $target")" || { checkout_mine "$name"; version_failed "$name"; }
  # shellcheck disable=SC2086
  reopen $ids
  printf '%s: %s now has the content of %s\n' "$v" "$name" "$target"
}

# Review-gated upstream update. Stages:
#   1. bring in the new upstream (skills CLI: run it; git repo: already pulled by the user)
#   2. record it on the upstream branch; the live folder keeps your version
#   3. no refinements of yours: take it as the next version. Otherwise merge in a
#      temporary worktree for review; the live folder stays on your version until --apply.
cmd_update() {
  local name="${1:-}" mode="review" fetch=1 msg="" fixes="" kind state rev wt v
  [ -n "$name" ] || die "usage: msl update <name> [--check] [--no-fetch] | --apply [-m summary] [--fixes ids] | --abort | --take-upstream"
  shift
  while [ $# -gt 0 ]; do
    case "$1" in
      --no-fetch) fetch=0 ;;
      --check) mode="check" ;;
      --apply) mode="apply" ;;
      --abort) mode="abort" ;;
      --take-upstream) mode="take" ;;
      -m) msg="${2:?}"; shift ;;
      --fixes) fixes="${2:?}"; shift ;;
      *) die "update: unknown option $1" ;;
    esac
    shift
  done
  use_skill "$name"
  kind="$(meta_get "$name" kind)"
  wt="$(merge_dir "$name")"
  has_upstream || die "$name is your own skill ($kind): it has no upstream to update from"

  case "$mode" in
    abort)
      [ -d "$wt" ] || die "no upstream merge in progress for $name"
      drop_merge "$name"
      printf 'dropped the pending merge; %s stays on %s (upstream %s still recorded, not merged)\n' "$name" "$(current_version)" "$(latest_upstream_rev)"
      return 0 ;;
    apply) update_apply "$name" "$msg" "$fixes"; return 0 ;;
  esac
  [ ! -d "$wt" ] || die "a merge is already waiting for review: msl diff $name --merge, then msl update $name --apply or --abort"

  state="$(skill_state "$name")"
  [ "$state" != changed ] || { autosave; die "$name has live edits (saved); keep or discard them before updating"; }
  [ "$state" != copies-differ ] || die "installed copies of $name were edited differently; resolve that first (msl status $name)"
  [ "$state" != missing ] || die "skill folder missing: $PRIMARY"

  # 1. Bring in the new upstream.
  if [ "$kind" = skills-cli ] && [ "$fetch" = 1 ] && [ "$state" != upstream-update ] && [ "$state" != upstream-live ]; then
    command -v npx >/dev/null 2>&1 || die "npx not found; install Node.js, or update with the skills CLI yourself and rerun with --no-fetch"
    printf 'fetching the latest %s with the skills CLI...\n' "$name"
    DO_NOT_TRACK=1 DISABLE_TELEMETRY=1 npx -y skills update "$name" -g -y >/dev/null 2>&1 \
      || warn "skills CLI update reported a problem; continuing with what is on disk"
    use_skill "$name"
    state="$(skill_state "$name")"
  fi

  # 2. Record it, and put your version back in the folder. Not for a skill that lives
  #    in a git repo: that folder is the repo's working tree, which msl never rewrites
  #    except to apply a merge you approved.
  if [ "$state" = upstream-update ] || [ "$state" = upstream-live ]; then
    record_upstream "$name"
    [ "$kind" = git ] || checkout_mine "$name"
  fi

  if g merge-base --is-ancestor upstream mine; then
    printf '%s is up to date (%s, upstream %s)\n' "$name" "$(current_version)" "$(latest_upstream_rev)"
    return 0
  fi
  rev="$(latest_upstream_rev)"

  # 3. Report (--check), take, or merge for review.
  if [ "$mode" = check ]; then
    printf 'upstream %s is available for %s and not in your version yet (%s). Nothing was changed.\n' "$rev" "$name" "$(current_version)"
    printf 'To take it: msl update %s' "$name"
    if has_refinements; then printf ' (merged with your refinements for review first)\n'; else printf ' (you have no refinements, so it applies directly)\n'; fi
    printf '\n# what upstream changed (last upstream in your version -> upstream %s)\n' "$rev"
    g diff "$(g merge-base mine upstream)" upstream
    return 0
  fi
  if [ "$mode" = take ]; then
    drop_merge "$name"
    v="$(take_upstream "$name" "took upstream $rev as-is (local refinements dropped)")" || version_failed "$name"
    printf '%s: %s now runs upstream %s as published; earlier versions stay in msl history\n' "$v" "$name" "$rev"
    return 0
  fi
  if ! has_refinements; then
    v="$(take_upstream "$name" "took upstream $rev")" || version_failed "$name"
    printf '%s: %s updated to upstream %s (you had no refinements to merge)\n' "$v" "$name" "$rev"
    return 0
  fi
  g worktree add -q --detach "$wt" mine >/dev/null 2>&1
  # What the review was based on: --apply refuses if either changes in the meantime.
  printf 'mine %s\nlive %s\n' "$(g rev-parse mine)" "$(live_tree)" > "$GD/msl-merge-state"
  if gw "$wt" merge -q --no-ff --no-commit upstream >/dev/null 2>&1; then
    printf 'Upstream %s merged with your version cleanly, waiting for review. The live skill is unchanged.\n' "$rev"
  else
    printf 'Upstream %s merged with your version, with conflicts in:\n' "$rev"
    git -C "$wt" diff --name-only --diff-filter=U | sed 's/^/  /'
    printf 'Resolve the <<<<<<< / >>>>>>> sections in %s. The live skill is unchanged.\n' "$(tilde "$wt")"
  fi
  printf 'Review:  msl diff %s --merge        (what your skill would become)\n' "$name"
  printf '         msl diff %s --upstream     (your refinements before this update)\n' "$name"
  printf 'Then:    msl update %s --apply [-m summary] [--fixes fb-…]   or   msl update %s --abort\n' "$name" "$name"
}

update_apply() { # name msg fixes
  local name="$1" msg="$2" fixes="$3" wt rev v c live
  wt="$(merge_dir "$name")"
  [ -d "$wt" ] || die "no upstream merge in progress for $name"
  if grep -rlE '^(<<<<<<<|>>>>>>>)( |$)' "$wt" --exclude-dir=.git >/dev/null 2>&1; then
    die "unresolved conflict markers remain in $(tilde "$wt"); resolve them first"
  fi
  check_ids "$fixes" "$name"
  # The merge was reviewed against a version and a folder: if either changed since
  # (an edit during the review, in any copy), applying would overwrite newer work.
  live="missing"; [ ! -d "$PRIMARY" ] || live="$(live_tree)"
  if [ -n "$COPY_CONFLICT" ] || [ "$(g rev-parse mine)" != "$(awk '$1 == "mine" { print $2 }' "$GD/msl-merge-state" 2>/dev/null)" ] \
    || [ "$live" != "$(awk '$1 == "live" { print $2 }' "$GD/msl-merge-state" 2>/dev/null)" ]; then
    die "$name changed while the merge was waiting for review, so nothing was applied and your changes are untouched. Start over: msl update $name --abort, keep or discard the new edits, then msl update $name"
  fi
  rev="$(latest_upstream_rev)"
  v="$(next_version)"
  gw "$wt" add -A >/dev/null 2>&1
  gw "$wt" commit -q --allow-empty -m "$v: took upstream $rev${msg:+; $msg}" -m "Upstream-Rev: $rev" || version_failed "$name"
  c="$(git -C "$wt" rev-parse HEAD)"
  # A git repo's folder can hold more than the merge (what a pull brought, other
  # uncommitted changes): save it before the approved result replaces it.
  if [ "$live" != missing ] && [ "$live" != "$(g rev-parse "$c^{tree}")" ] && [ "$live" != "$(mine_tree)" ] \
    && ! upstream_trees | grep -x "$live" >/dev/null; then
    autosave
  fi
  drop_merge "$name"
  g update-ref refs/heads/mine "$c"
  tag_version "$name" "$v" >/dev/null || version_failed "$name"
  [ -z "$fixes" ] || mark_applied "$fixes" "$v"
  printf '%s: %s now runs upstream %s with your refinements\n' "$v" "$name" "$rev"
}

cmd_git() { use_skill "${1:?usage: msl git <name> <git args…>}"; shift; g "$@"; }

usage() {
  cat <<EOF
msl $MSL_VERSION: meta-skill-loop bookkeeping (data in $(tilde "$MSL_HOME"))

  msl status [name]                  managed skills, versions, open feedback, what needs attention
  msl add [name|path] [--kind K]     start managing a skill (not modified); no name: list installed skills
  msl remove <name>                  stop managing it (data archived; skill untouched)

  msl feedback add <name> -t <title> [--severity P0|P1|P2|P3|nit] [--tool T] [--version vN]
                   [--session FILE|none] < body
  msl feedback list <name> [--all]
  msl feedback mark <fb-id> open|applied|declined [--fixed-in vN]

  msl diff <name> [vA [vB] | --upstream | --merge | --saved]
  msl keep <name> -m <summary> [--fixes fb-…,fb-…] [--from <path>]   live edits become the next version
  msl discard <name>                 throw away live edits (saved: msl restore brings them back)
  msl restore <name>
  msl history <name>
  msl revert <name> <vN>             undo one version, keep the rest
  msl rollback <name> <vN> [--yes]   go back to a version
  msl update <name> [--check] [--no-fetch] | --apply [-m s] [--fixes ids] | --abort | --take-upstream

  msl path <name> | msl git <name> <git args…> | msl init | msl version
EOF
}

main() {
  local cmd="${1:-help}"
  [ $# -eq 0 ] || shift
  case "$cmd" in
    init|add|remove|status|path|feedback|diff|keep|discard|restore|history|revert|rollback|update|git) ;;
    version|--version|help|-h|--help) ;;
    *) usage >&2; exit 2 ;;
  esac
  case "$cmd" in init|version|--version|help|-h|--help) ;; *) ensure_ws; ensure_launcher ;; esac
  case "$cmd" in
    init) cmd_init "$@" ;;
    add) cmd_add "$@" ;;
    remove) cmd_remove "$@" ;;
    status) cmd_status "$@" ;;
    path) cmd_path "$@" ;;
    feedback) cmd_feedback "$@" ;;
    diff) cmd_diff "$@" ;;
    keep) cmd_keep "$@" ;;
    discard) cmd_discard "$@" ;;
    restore) cmd_restore "$@" ;;
    history) cmd_history "$@" ;;
    revert) cmd_revert "$@" ;;
    rollback) cmd_rollback "$@" ;;
    update) cmd_update "$@" ;;
    git) cmd_git "$@" ;;
    version|--version) echo "$MSL_VERSION" ;;
    help|-h|--help) usage ;;
  esac
}

main "$@"
